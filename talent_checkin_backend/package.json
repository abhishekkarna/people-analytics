{
  "name": "talent-directory-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "tsc --project tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "nodemon --watch src --ignore dist --ignore node_modules -r tsconfig-paths/register src/index.ts",
    "migrate": "ts-node ./node_modules/.bin/sequelize db:migrate --migrations-path src/db/migrations",
    "migrate:one": "ts-node ./node_modules/.bin/sequelize db:migrate --migrations-path src/db/migrations --name",
    "seed:all": "npx ts-node -r tsconfig-paths/register node_modules/.bin/sequelize-cli db:seed:all",
    "seed:one": "npx ts-node -r tsconfig-paths/register node_modules/.bin/sequelize-cli db:seed --seed",
    "migrate:undo": "ts-node ./node_modules/.bin/sequelize db:migrate:undo --migrations-path src/db/migrations",
    "migrate:undo:one": "ts-node ./node_modules/.bin/sequelize db:migrate:undo --name"
  },
  "dependencies": {
    "@types/compression": "^1.7.5",
    "@types/swagger-jsdoc": "^6.0.4",
    "bcryptjs": "^2.4.3",
    "chalk": "^4.1.2",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dd-trace": "^5.33.1",
    "dotenv": "^16.4.7",
    "express": "^4.18.2",
    "express-correlation-id": "^3.0.1",
    "jsonwebtoken": "^8.5.1",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "sqlite3": "^5.1.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tsconfig-paths": "^4.2.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-correlation-id": "^1.2.6",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.12.0",
    "@types/pg": "^8.11.11",
    "@types/sequelize": "^4.28.20",
    "@types/swagger-ui-express": "^4.1.7",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9",
    "sequelize-cli": "^6.6.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "typescript": "^5.7.3"
  }
}
